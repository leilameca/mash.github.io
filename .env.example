# Use a separate Supabase project for local/staging/Preview.
NEXT_PUBLIC_SUPABASE_URL=
# Preferred. Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted when this is absent.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: retained exclusively for OTP allowlist/bootstrap operations.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://www.mashoficial.com
# NEXT_PUBLIC_ENABLE_SUPABASE_CATALOG is obsolete and ignored.
# MASH_ADMIN_ROUTE is obsolete; the administrative route is /studio-mash.

# Server only. Leave empty until provider verification is authorized.
MASH_DEEPL_API_KEY=

# Set to 1 for isolated hosted staging. Keeps the app out of search indexes.
MASH_STAGING=
# Optional public Storage host for legacy photos during private review.
MASH_PREVIEW_MEDIA_HOST=

# Keep collection disabled until approval, consent and the Google stream are verified.
MASH_GA_ENABLED=
NEXT_PUBLIC_MASH_GA_ID=
# Server-only read-only property reporting for Studio.
MASH_GA_PROPERTY_ID=
MASH_GA_SERVICE_ACCOUNT_JSON=
