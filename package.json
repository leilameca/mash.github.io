{
  "name": "mash-frontend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:products": "node --test tests/admin-content.test.cjs",
    "test:admin": "node --test tests/admin-content.test.cjs tests/catalog.test.cjs tests/media-library.test.cjs tests/site-content.test.cjs",
    "test:ux": "node tests/admin-ui-browser.cjs && node tests/ux-browser.cjs",
    "test:pwa": "node --test tests/pwa.test.cjs",
    "test:pwa:browser": "node tests/pwa-browser.cjs",
    "test:phase2": "node --test tests/publication-db.test.cjs tests/action-db.test.cjs tests/security-content.test.cjs tests/auth-regression.test.cjs tests/middleware-auth.test.cjs",
    "test:phase2:http": "node tests/phase2-http.cjs",
    "test:phase3": "node --test tests/studio-security.test.cjs",
    "test:phase3:browser": "node tests/studio-browser.cjs",
    "preview:studio": "node tests/support/preview-server.cjs",
    "test:phase4": "node --test tests/media-processing.test.cjs tests/media-db.test.cjs tests/media-upload.test.cjs",
    "test:phase4:browser": "node tests/phase4-browser.cjs",
    "test:phase5": "node --test tests/translation.test.cjs",
    "test:phase5:browser": "node tests/phase5-browser.cjs",
    "test:phase6": "node --test tests/visual.test.cjs",
    "test:phase6:browser": "node tests/phase6-browser.cjs",
    "test:phase7": "node --test tests/phase7.test.cjs",
    "test:phase7:browser": "node tests/phase7-browser.cjs",
    "test:phase8": "node --test tests/phase8.test.cjs",
    "test:staging:browser": "node tests/staging-browser.cjs",
    "test:analytics:browser": "node tests/analytics-browser.cjs",
    "test:accessibility:browser": "node tests/accessibility-browser.cjs",
    "test:phase8:browser": "node tests/phase8-browser.cjs",
    "test:all": "npm run test:admin && npm run test:pwa && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6 && npm run test:phase7 && npm run test:phase8"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "google-auth-library": "11.3.4",
    "gsap": "^3.13.0",
    "next": "15.5.29",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "axe-core": "4.13.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.5.29",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "8.5.33",
    "source-map-js": "1.2.4"
  }
}
